<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="daars_arena">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- 8m x 8m arena walls -->
    <model name="wall_n"><static>true</static><pose>4 8.05 0.25 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>8.1 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.1 0.1 0.5</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>
    <model name="wall_s"><static>true</static><pose>4 -0.05 0.25 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>8.1 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.1 0.1 0.5</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>
    <model name="wall_e"><static>true</static><pose>8.05 4 0.25 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.1 8.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8.1 0.5</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>
    <model name="wall_w"><static>true</static><pose>-0.05 4 0.25 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.1 8.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8.1 0.5</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>

    <!-- 16 cylindrical obstacles: dense layout with 11 tight passages -->
    <!-- Matches Complex training scenario density (16 obs in 64m²) -->
    <model name="o01"><static>true</static><pose>1.5 1.5 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.4</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>0.5</length></cylinder></geometry><material><ambient>0.85 0.25 0.25 1</ambient></material></visual></link></model>
    <model name="o02"><static>true</static><pose>3.0 1.3 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.35</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.35</radius><length>0.5</length></cylinder></geometry><material><ambient>0.85 0.25 0.25 1</ambient></material></visual></link></model>
    <model name="o03"><static>true</static><pose>4.5 1.7 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.45</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.45</radius><length>0.5</length></cylinder></geometry><material><ambient>0.85 0.25 0.25 1</ambient></material></visual></link></model>
    <model name="o04"><static>true</static><pose>6.2 1.4 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.35</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.35</radius><length>0.5</length></cylinder></geometry><material><ambient>0.85 0.25 0.25 1</ambient></material></visual></link></model>
    <model name="o05"><static>true</static><pose>2.0 3.0 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.4</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>0.5</length></cylinder></geometry><material><ambient>0.85 0.25 0.25 1</ambient></material></visual></link></model>
    <model name="o06"><static>true</static><pose>3.8 2.8 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry><material><ambient>0.85 0.25 0.25 1</ambient></material></visual></link></model>
    <model name="o07"><static>true</static><pose>5.5 3.2 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.45</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.45</radius><length>0.5</length></cylinder></geometry><material><ambient>0.85 0.25 0.25 1</ambient></material></visual></link></model>
    <model name="o08"><static>true</static><pose>1.3 4.5 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.35</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.35</radius><length>0.5</length></cylinder></geometry><material><ambient>0.85 0.25 0.25 1</ambient></material></visual></link></model>
    <model name="o09"><static>true</static><pose>3.2 4.8 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.4</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>0.5</length></cylinder></geometry><material><ambient>0.85 0.25 0.25 1</ambient></material></visual></link></model>
    <model name="o10"><static>true</static><pose>5.0 4.3 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.35</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.35</radius><length>0.5</length></cylinder></geometry><material><ambient>0.85 0.25 0.25 1</ambient></material></visual></link></model>
    <model name="o11"><static>true</static><pose>6.5 4.7 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry><material><ambient>0.85 0.25 0.25 1</ambient></material></visual></link></model>
    <model name="o12"><static>true</static><pose>2.0 6.0 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.45</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.45</radius><length>0.5</length></cylinder></geometry><material><ambient>0.85 0.25 0.25 1</ambient></material></visual></link></model>
    <model name="o13"><static>true</static><pose>4.0 6.3 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.35</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.35</radius><length>0.5</length></cylinder></geometry><material><ambient>0.85 0.25 0.25 1</ambient></material></visual></link></model>
    <model name="o14"><static>true</static><pose>5.8 5.8 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.4</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>0.5</length></cylinder></geometry><material><ambient>0.85 0.25 0.25 1</ambient></material></visual></link></model>
    <model name="o15"><static>true</static><pose>6.8 6.5 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry><material><ambient>0.85 0.25 0.25 1</ambient></material></visual></link></model>
    <model name="o16"><static>true</static><pose>1.0 2.5 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry><material><ambient>0.85 0.25 0.25 1</ambient></material></visual></link></model>

    <!-- Gazebo plugins -->
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so"/>
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>
  </world>
</sdf>
 